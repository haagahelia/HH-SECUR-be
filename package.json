{
  "name": "hh-secur-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "predev": "npm run migrate",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prestart": "npm run migrate",
    "start": "node dist/index.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "migrate": "node scripts/migrate.js",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:new": "sequelize-cli migration:generate --name",
    "db:reset": "docker compose -f docker-compose-dbbe.yaml down -v && docker compose -f docker-compose-dbbe.yaml up -d --wait hh_secur_db_service && npm run migrate"
  },
  "keywords": [],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  }
}
