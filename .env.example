# Copy this file to .env and fill in the values. Never commit .env.
# Real Rahti values: Teams → DevOps → Shared → usernames_passwords.docx

# --- Server ---
PORT=3000

# --- Database (app connection, src/config.ts) ---
# npm run dev: localhost. Docker Compose overrides DB_HOST automatically.
DB_HOST=localhost
DB_PORT=3306
# Docker Compose: must NOT be root (MariaDB image rejects MARIADB_USER=root)
DB_USERNAME=YourDbUser
DB_PASSWORD=YourPassword
DB_DATABASE=YourDatabaseName

# --- Docker Compose only: MariaDB root password ---
MARIADB_ROOT_PASSWORD=YourRootPassword

# --- Auth ---
JWT_SECRET=longRandomSecretForJWT

# --- Seed users (created on startup and by /defaultuser, /defaultadmin) ---
DEFAULT_USER_USERNAME=usernameForDefaultUser
DEFAULT_USER_PASSWORD=passwordForDefaultUser
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_ROLE=user

DEFAULT_ADMIN_USERNAME=usernameForDefaultAdmin
DEFAULT_ADMIN_PASSWORD=passwordForDefaultAdmin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_ROLE=admin

# --- Optional extra users (1-5). A user is created only if all four are set. ---
EXTRA_USER_1_USERNAME=nameForExtraUser1
EXTRA_USER_1_PASSWORD=passwordForExtraUser1
EXTRA_USER_1_EMAIL=extra1@example.com
EXTRA_USER_1_ROLE=user
EXTRA_USER_2_USERNAME=nameForExtraUser2
EXTRA_USER_2_PASSWORD=passwordForExtraUser2
EXTRA_USER_2_EMAIL=extra2@example.com
EXTRA_USER_2_ROLE=user
EXTRA_USER_3_USERNAME=nameForExtraUser3
EXTRA_USER_3_PASSWORD=passwordForExtraUser3
EXTRA_USER_3_EMAIL=extra3@example.com
EXTRA_USER_3_ROLE=user
EXTRA_USER_4_USERNAME=nameForExtraUser4
EXTRA_USER_4_PASSWORD=passwordForExtraUser4
EXTRA_USER_4_EMAIL=extra4@example.com
EXTRA_USER_4_ROLE=user
EXTRA_USER_5_USERNAME=nameForExtraUser5
EXTRA_USER_5_PASSWORD=passwordForExtraUser5
EXTRA_USER_5_EMAIL=extra5@example.com
EXTRA_USER_5_ROLE=user

# --- Tests only (optional) ---
# API_BASE_URL=http://localhost:3000